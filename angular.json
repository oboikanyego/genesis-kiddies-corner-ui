{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "genesis-kiddies-corner-ui": {
      "projectType": "application",
      "schematics": { "@schematics/angular:component": { "style": "scss", "standalone": true } },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/genesis-kiddies-corner-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }, { "glob": "**/*", "input": "public", "output": "/" }],
            "styles": ["src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }],
              "outputHashing": "all",
              "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.production.ts" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "genesis-kiddies-corner-ui:build:production" }, "development": { "buildTarget": "genesis-kiddies-corner-ui:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": { "analytics": false }
}
